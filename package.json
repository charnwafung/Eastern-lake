{
  "name": "eastern-lake-pickup",
  "version": "1.0.0",
  "private": true,
  "description": "Online pickup ordering for Eastern Lake Restaurante Chino — Stripe Checkout + kitchen tablet printing",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "MOCK_PAYMENTS=1 KITCHEN_PIN=1234 node --no-warnings=ExperimentalWarning --watch server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "stripe": "^17.7.0"
  }
}
