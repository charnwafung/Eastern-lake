# Copy this file to .env for running on your own computer. On Render, set these in the dashboard instead.

# Stripe → Developers → API keys. Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe → Developers → Webhooks → your endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PIN the kitchen tablet uses to unlock the kitchen screen (numbers only, 4–8 digits)
KITCHEN_PIN=1234

# Any long random text. Keeps the tablet logged in across restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# Your public web address, e.g. https://ordenes.easternlakepr.com (used for Stripe return links)
PUBLIC_URL=http://localhost:3000

# Where the order database is stored (Render: /var/data)
# DATA_DIR=./var

# Local testing only: skip Stripe and mark orders paid instantly. Ignored when NODE_ENV=production.
# MOCK_PAYMENTS=1
